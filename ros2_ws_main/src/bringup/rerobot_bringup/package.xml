<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rerobot_bringup</name>
  <version>1.0.0</version>
  <description>Bringup launch / config / URDF / RViz assets for the reRoBot platform.</description>
  <maintainer email="analiveys326@gmail.com">YamamotoSoya</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>epos4_controller</exec_depend>
  <exec_depend>maxon_epos4_ros2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- claude: 2D LiDAR (rerobot_bringup_2d.launch.py) -->
  <exec_depend>urg_node</exec_depend>
  <!-- claude: 3D LiDAR (rerobot_bringup_3d.launch.py, src/external/StarROS2) -->
  <exec_depend>rfans_driver</exec_depend>
  <!-- claude: slam_toolbox 系は rerobot_slamtoolbox (ros2_ws_slamtoolbox) に分離済み -->
  <!-- claude: Nav2 最小構成 (nav2.launch.py) で起動するサーバ群 -->
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <!-- claude: Xbox / joystick teleop (joy_teleop.launch.py 用)。
       やめるときは下の2行と launch/joy_teleop.launch.py,
       config/joy_teleop.yaml を削除すれば完全に撤去できます。 -->
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
