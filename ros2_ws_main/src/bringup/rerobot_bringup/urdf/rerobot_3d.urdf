<?xml version="1.0"?>
<!-- claude: 3D LiDAR (R-Fans) 構成用 URDF。rerobot_2d.urdf を雛形に、LiDAR を
     2D の laser と同位置 (xyz 0 0 0.714) の rfans link に差し替えたもの。 -->
<robot name="rerobot">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.35 0.10"/>
      </geometry>
      <material name="body_gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <link name="m1_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="m2_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="m1_wheel" type="continuous">
    <parent link="base_link"/>
    <child  link="m1_wheel_link"/>
    <origin xyz="0 0.205 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="m2_wheel" type="continuous">
    <parent link="base_link"/>
    <child  link="m2_wheel_link"/>
    <origin xyz="0 -0.205 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- claude: 3D LiDAR (R-Fans, 簡易ジオメトリ) — 2D laser と同位置 (車軸中心
       z=0.075 の 0.639 m 上 = base_link から z=0.714)。link 名 rfans は
       rerobot_bringup_3d.launch.py / params_3d.yaml の frame_id と一致させること。 -->
  <link name="rfans">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="rfans_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rfans"/>
    <origin xyz="0 0 0.714" rpy="0 0 0"/>
  </joint>

  <!-- claude: BNO086 IMU (bno086_imu_driver の frame_id 既定 imu_link と一致させる)。
       搭載位置はとりあえず 3D LiDAR (rfans) と同位置 — 実搭載位置が決まったら更新。
       ボードの 180° 実装はドライバ側 mount_yaw_deg=180 で補正済みなので rpy は 0。 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.1 0.6 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.714" rpy="0 0 0"/>
  </joint>

</robot>
