<?xml version="1.0"?>
<!-- claude: 統合 URDF (2026-08-10)。実機には 2D LiDAR (UTM-30LX) と 3D LiDAR (R-Fans-16)
     が両方常設 + BNO086 IMU を搭載予定のため、旧 rerobot_2d.urdf / rerobot_3d.urdf を
     1 本に統合した。起動するドライバは rerobot_bringup.launch.py の引数で選ぶ
     (URDF は常に全センサの TF を出す — 使わないセンサの静的 TF が残っても無害)。
     センサ位置はユーザ実測値 (2026-08-31 車体改修後の再実測): laser (0.067, 0, 0.09406,
     上下反転取付 = roll=pi) / rfans (0.038, 0, 0.80746 — 換算値、要再実測) / imu (0, 0, 0.74196, **上下逆 + yaw −93° = rpy (pi,0,−1.6257)、2026-09-24 実測**) / imu_wit (−0.065, 0, 0.57746, 上下逆 roll=pi — 2026-09-24 比較用)。
     rfans は前傾 15° 取付・ヨー回転なし = ケーブル前向き (rpy=(0,pi/12,0) — 詳細は rfans_joint のコメント参照)。

     ⚠️ rfans 取付プリセット (2026-08-15 導入、丸ごとコピー方式): この内容 = tilted15。
     プリセットは rerobot.{tilted45,tilted15,flat}.urdf。切替は必ず GLIM 側
     ros2_ws_glim/config/config_sensors.{tilted45,tilted15,flat}.json とセットで cp する:
       cp ros2_ws_main/src/bringup/rerobot_bringup/urdf/rerobot.<preset>.urdf \
          ros2_ws_main/src/bringup/rerobot_bringup/urdf/rerobot.urdf
       cp ros2_ws_glim/config/config_sensors.<preset>.json \
          ros2_ws_glim/config/config_sensors.json
     rfans 以外を編集したら同じ変更を全プリセットにも反映すること (コピー方式の宿命)。 -->
<robot name="rerobot">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.35 0.10"/>
      </geometry>
      <material name="body_gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <link name="m1_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.128" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="m2_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.128" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- claude: motor1 = 右輪 (y-), motor2 = 左輪 (y+) が実配線だが、URDF の可視化上は
       車軸位置さえ合っていれば左右の別は TF に影響しない (wheel joint は可視化専用)。 -->
  <joint name="m1_wheel" type="continuous">
    <parent link="base_link"/>
    <child  link="m1_wheel_link"/>
    <origin xyz="0 0.2645 0.128" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="m2_wheel" type="continuous">
    <parent link="base_link"/>
    <child  link="m2_wheel_link"/>
    <origin xyz="0 -0.2645 0.128" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- claude: 2D LiDAR (HOKUYO UTM-30LX, 簡易ジオメトリ)。xyz はユーザ実測 (2026-08-31)。
       2026-08-31: 車体改修で上下反転取付になった (ユーザ申告) → roll=π を設定。
       ⚠️ 反転の軸 (roll=π か pitch=π か) で前方の向きが 180° 変わる — 実機 /scan で
       「前方障害物が +X・左の物が +Y」に出るか要確認。180° ズレていたら pitch=π に変更。 -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="0.067 0 0.09406" rpy="3.141592653589793 0 0"/>
  </joint>

  <!-- claude: 3D LiDAR (R-Fans-16, 簡易ジオメトリ)。link 名 rfans は
       rerobot_bringup.launch.py / params.yaml (rfans_driver.frame_id) と一致させること。
       取付 (tilted15): 前方 15° 前傾のみ、ヨー回転なし (ケーブル側=センサ+X が前方下向き
       — flat と同じくケーブル前向き。tilted45 のヨー 180° とは異なるので注意)。
       R = Ry(+15°) → URDF rpy = (0, +pi/12, 0)。
       ⚠️ xyz は 2026-08-31 の換算値 = 新 flat 実測 (0, 0, 0.80246) + 旧 flat→tilted15 オフセット
       (+0.038, 0, +0.005)。この取付へ実際に切り替える際は要再実測。
       ⚠️ rpy/xyz を変えたら ros2_ws_glim/config/config_sensors.json の T_lidar_imu を要再計算。 -->
  <link name="rfans">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="lidar_blue2">
        <color rgba="0.1 0.5 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="rfans_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rfans"/>
    <origin xyz="0.038 0 0.80746" rpy="0 0.2617993878 0"/>
  </joint>

  <!-- claude: BNO086 IMU (bno086_imu_driver の frame_id 既定 imu_link と一致させる)。
       xyz はユーザ実測 (2026-08-10)。向き (rpy) は 2026-08-11 の実走 bag (ekf_test) で最終確定:
         rpy = (0, 0, π/2) = Rz(+90°)。正立、上から見て 90° 回し取付。
         軸対応: imu_X→base_Y, imu_Y→base_-X, imu_Z→base_Z。
       証拠 3 系統 (bag /workspace/log/ekf_test, 2026-08-11):
         (1) 静止 60 s の accel z = +9.815 m/s² → Z 上向き (正立)
         (2) 旋回中の gyro_z / 車輪 odom yaw rate = +1.015, 同符号率 100% → Z 反転なし
         (3) 裏返し URDF で走った EKF の yaw が車輪 odom の鏡像 (-79° vs +74°) → 反転の実害を確認
       注: 「裏返し (π,0,π/2)」説は 08-11 の目視確認に基づいたが、RViz 矢印表示のバグ
       (fixed_frame_orientation) 修正前の見え方と混線していた可能性が高く、実走データで棄却。
       ⚠️ この rpy を変えたら ros2_ws_glim/config/config_sensors.json の T_lidar_imu も要再計算。 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.1 0.6 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <!-- claude: 2026-09-24 実測で rpy を (0,0,+pi/2) → (pi, 0, -1.625736) に修正。
       BNO086 は **上下逆 (部品面が下) + yaw -93.15°** で取り付いている。従来の「正立 +90°」は
       ドライバ既定 auto_tare: all が accel/gyro を起動時姿勢の座標へ回していたため見えなかった
       (08-11 の 3 証拠は全て tare 後の値。docs/issue/2026-09-24_bno086_auto_tare_rotates_motion_outputs.md)。
       根拠: auto_tare off + reset で accel z=-9.9 / 前上げ→sensor -y・左上げ→sensor -x (事前予測的中) /
       CCW 旋回で gyro_z 負 (WT901C と大きさ一致 -84.9 vs -85.1°)。yaw は WT901C 相対の 3 姿勢 Kabsch、不確かさ ±2.5°
       (WT 側 yaw 未較正込み)。roll/pitch は名目 (pi, 0) — 残差 <1° は WT 基準の誤差内。
       ⚠️ accel に見える sensor-x 6.6° の傾きは **加速度計バイアス +1.12 m/s² で回転ではない** (旋回ジャイロ比 ≈0
       で識別、critic 査読) → URDF に入れない。⚠️ 前提: bno086.yaml の mount_yaw_deg: 180 と auto_tare: off。
       ~/tare・~/tare_yaw サービス (persist) を呼んだら再測定。tare-all 時代 (〜2026-09-23) の bag には
       この rpy を使わない (旧 Rz(90°) + bag ごとの yaw 補正。GLIM 側は config_sensors.flat_tareall_legacy.json)。
       ⚠️ 変えたら ros2_ws_glim/config/config_sensors*.json の T_lidar_imu も要再計算。 -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.74196" rpy="3.141592653589793 0 -1.625736"/>
  </joint>

  <!-- claude: 比較用 IMU WITmotion WT901C-TTL (witmotion_ros の frame_id imu_wit_link と一致)。2026-09-24 追加。
       xyz はユーザ実測 (x −65 mm, y 0, z 577.46 mm、ケース中心)。
       rpy: 静置重力 (z=−9.86) + ノーズアップで x>0 + 手回転で gyro_z 符号反転 の 3 証拠から
       「x 前向き・上下逆 = roll=pi」で確定 (2026-09-24)。yaw は暫定 0 — BNO086 との 24° 差の原因が
       未識別 (取付 / BNO086 auto_tare / WT 側) のため、決着後に必要なら更新する。
       ⚠️ 他プリセット (rerobot.{tilted45,tilted15,flat}.urdf) にも同じ記述あり — 変更は 4 ファイル同時に。 -->
  <link name="imu_wit_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.035 0.015"/>
      </geometry>
      <material name="imu_wit_orange">
        <color rgba="0.9 0.5 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="imu_wit_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_wit_link"/>
    <origin xyz="-0.065 0 0.57746" rpy="3.141592653589793 0 0"/>
  </joint>

</robot>
