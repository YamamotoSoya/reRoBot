<?xml version="1.0"?>
<robot name="rerobot">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.35 0.10"/>
      </geometry>
      <material name="body_gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <link name="m1_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="m2_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="m1_wheel" type="continuous">
    <parent link="base_link"/>
    <child  link="m1_wheel_link"/>
    <origin xyz="0 0.205 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="m2_wheel" type="continuous">
    <parent link="base_link"/>
    <child  link="m2_wheel_link"/>
    <origin xyz="0 -0.205 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- claude: 2D LiDAR (簡易ジオメトリ) — 車軸中心 (z=0.075) の 0.639 m 上 -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- claude: LiDAR は上下逆さに取付 (2026-08-01 ユーザ申告)。roll=π で反転を表現。
       スキャン面の高さ (光学中心 z=0.714) は変わらない。
       前後が 180° ずれて見える場合は取付の向きが逆なので rpy="0 3.14159... 0" (pitch=π) に変更する。-->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="0 0 0.714" rpy="3.141592653589793 0 0"/>
  </joint>

  <!-- claude: BNO086 IMU (bno086_imu_driver の frame_id 既定 imu_link と一致させる)。
       搭載位置はとりあえず 3D LiDAR (rfans) と同位置 — 実搭載位置が決まったら更新。
       LiDAR と違い IMU 基板は正立取付想定なので rpy は 0
       (ボードの 180° 実装はドライバ側 mount_yaw_deg=180 で補正済み)。 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.1 0.6 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.714" rpy="0 0 0"/>
  </joint>

</robot>
