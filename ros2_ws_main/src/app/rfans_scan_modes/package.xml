<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- claude: 2026-10-01 新設。3D 点群→LaserScan 変換で方位ビン内の選び方 (nearest/farthest/nth) を切り替える実験用ノード -->
  <name>rfans_scan_modes</name>
  <version>0.1.0</version>
  <description>3D LiDAR point cloud to LaserScan with selectable per-azimuth-bin reduction (nearest / farthest / n-th nearest)</description>
  <maintainer email="s25c1124xr@chibatech.ac.jp">reRoBot</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
