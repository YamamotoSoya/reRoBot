# claude: 再編 (2026-07-26) — 旧ルート Dockerfile を main コンテナ用に減量したもの。
#   slam_toolbox            → Dockerfile_slamtoolbox (別コンテナ)
#   LIO-SAM 依存 (PCL/GTSAM) → Dockerfile_liosam (別コンテナ, IMU 再入手まで凍結)
#   GLIM                    → 公式イメージ koide3/glim_ros2:jazzy (Dockerfile なし)
# main が担うもの: CAN モータ制御 + LiDAR/RealSense ドライバ + odometry + Nav2 + teleop。
FROM ros:jazzy-ros-base

RUN apt-get update && apt-get install -y \
    python3-argcomplete \
    python3-colcon-common-extensions \
    libboost-system-dev \
    build-essential \
    libudev-dev \
    udev \
    git \
    nano \
    vim \
    ros-jazzy-ros2-control \
    # --- Visualization ---
    ros-jazzy-rviz2 \
    ros-jazzy-rqt \
    ros-jazzy-rqt-common-plugins \
    ros-jazzy-rqt-tf-tree \
    ros-jazzy-tf2-tools \
    # --- CANopen ---
    can-utils \
    iproute2 \
    # ↑ ip link で can0/vcan0 をコンテナ内から操作するため (verify スキルの vcan モードが使用) # claude
    ros-jazzy-canopen \
    ros-jazzy-canopen-fake-slaves \
    ros-jazzy-canopen-proxy-driver \
    ros-jazzy-canopen-master-driver \
    ros-jazzy-canopen-402-driver \
    # --- HOKUYO urg_node ---
    ros-jazzy-urg-node \
    # --- Xbox / joystick teleop --- # claude
    ros-jazzy-joy \
    ros-jazzy-teleop-twist-joy \
    # --- navigation2 (main に統合 — apt 同士で依存衝突が無いため分離しない) --- # claude
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-nav2-minimal-tb* \
    # --- sensor integration (EKF,UKF) ---
    ros-jazzy-robot-localization \
    # --- LiDAR (Sure-Star RFans/CFans rfans_driver) ---
    libpcap-dev \
    # --- tf2 基本 (epos4_odometry / realsense2_camera が使用) --- # claude
    ros-jazzy-tf2 \
    ros-jazzy-tf2-ros \
    # --- realsense2_camera のビルド依存 --- # claude
    # 旧 Dockerfile では cv_bridge を「LIO-SAM 用」とコメントしていたが、実際は
    # realsense2_camera も要求する。image_transport / diagnostic_updater / eigen は
    # 旧 Dockerfile に無く、realsense-ros のビルドに必要なため追加。 # claude
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-diagnostic-updater \
    libeigen3-dev \
    # 6軸IMU(RealSense) → orientation付与 (GLIM/LIO 系の入力用) # claude
    ros-jazzy-imu-filter-madgwick \
    # --- BNO086 IMU driver (bno086_imu_driver) の実行時依存 (pyserial) --- # claude
    python3-serial \
    # -----------------------------------
    && rm -rf /var/lib/apt/lists/*

# Create can group and add root user to it
RUN groupadd -f can && usermod -a -G can root

# --- librealsense (Intel RealSense SDK) ---
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-librealsense2* \
     && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# claude: 対話シェル用。スクリプト (docker exec bash -c) は .bashrc を読まないため、
# ROS_DOMAIN_ID は docker-compose.yml の environment でも設定している (そちらが正)。
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=150" >> ~/.bashrc && \
    echo "source /usr/share/colcon_cd/function/colcon_cd.sh" >> ~/.bashrc && \
    echo "export _colcon_cd_root=/opt/ros/jazzy/" >> ~/.bashrc

CMD ["bash"]
