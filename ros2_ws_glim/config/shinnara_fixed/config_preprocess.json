{
  "preprocess": {
    "crop_bbox_frame": "lidar",
    "crop_bbox_max": [
      1.0,
      1.0,
      1.0
    ],
    "crop_bbox_min": [
      -1.0,
      -1.0,
      -1.0
    ],
    // claude: 2026-10-23 ユーザ指示 — 100 -> 180 m。R-Fans の遠方点まで地図に使う。
    //   スキャンあたりの生点が増えるので密度の天井も上がるが、遠方点はノイズ率が高い
    //   (09-18 の 2D 変換の実測で 30 m 超は 31%)。資源は cal で確認すること。
    "distance_far_thresh": 180.0,
    "distance_near_thresh": 0.5,
    "downsample_resolution": 0.15,
    "enable_cropbox_filter": false,
    // claude: 2026-10-23 確定 — true -> false。縮退とは無関係 (単独では直らない) だが、
    //   S3 の実測で traj z 幅が 12.88 -> 5.63 m と半減する。z ドリフトに対して有害。
    "enable_outlier_removal": false,
    "k_correspondences": 25,
    "num_threads": 6,
    "outlier_removal_k": 20,
    "outlier_std_mul_factor": 1.0,
    "random_downsample_rate": 0.1,
    // claude: 2026-10-23 確定 — 50,000 -> 10,000。odom 追従喪失の唯一の原因。
    //   randomgrid_sampling は rate (= target / 点数) が 0.99 以上だと素通しする
    //   (gtsam_points/types/point_cloud_cpu_funcs.cpp 冒頭)。50,000 は生点 27,114 を超えるため
    //   間引きが一切働かず、生スキャンがそのまま odometry に入っていた。
    //   間引きの実体は「ボクセルごとに points_per_voxel 点まで」という空間的な均しで、
    //   効かせると 20 m 超の点の重みが 1.9% -> 9.7% (5 倍) になる (遠方点の絶対数 525 は不変)。
    //   進行方向を拘束できるのは遠方構造だけなので、素通しだと植え込み通路で照合が解を失う。
    "random_downsample_target": 10000,
    "use_random_grid_downsampling": true
  }
}